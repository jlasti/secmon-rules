# ==================================
# === MISP HIGH Threat Match (TL=1) ===
# ==================================
type=Single
ptype=RegExp
continue=TakeNext
pattern=(?:\d+:)?(\w{3}\s+\d{1,2}\s+\d{2}:\d{2}:\d{2})\s+(\S+)\s+CEF:.*?SecmonMisp(Src|Dst)Hit=true\s+SecmonMisp\3Id=(\d+)\s+SecmonMisp\3Tl=1
desc=MISP $3 HIGH threat (Attr ID: $4)
action=write /var/www/html/secmon/__secInput $1 $2 CEF:0|Security|MISP|1|200|MISP High Threat Match|8|att=SecmonMispIntel SecmonMispHitType=$3 SecmonMispAttributeId=$4 SecmonMispThreatLevel=1 rawEvent=$0

# ==================================
